<?xml version="1.0"?>
<package format="2">
  <name>tactile_sensor_driver</name>
  <version>0.0.0</version>
  <description>C++ version of I2C tactile sensor driver (ROS1 Melodic)</description>
  <maintainer email="your@email.com">Your Name</maintainer>
  <license>TODO</license>

  <!-- ROS1 依赖 -->
  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>roscpp</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>message_generation</build_depend> <!-- ROS1 自定义消息 / 服务编译专用依赖，运行时不需要 -->
  <build_depend>tactile_sensor_msgs</build_depend>

  <exec_depend>roscpp</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>message_runtime</exec_depend> <!-- ROS1 消息运行时库，编译阶段不需要 -->
  <exec_depend>tactile_sensor_msgs</exec_depend>

  <!-- 导出标记 -->
  <export>
    <build_type>catkin</build_type>
  </export>
</package>