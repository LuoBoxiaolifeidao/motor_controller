<?xml version="1.0"?>
<launch>
  <!-- 启动 tactile_node 节点 -->
  <node name="tactile_node" 
        pkg="tactile_sensor_driver" 
        type="tactile_node" 
        output="screen">

    <!-- 对应 ROS2 节点参数 -->
    <param name="polling_rate" value="100.0" />
    <param name="max_finger_num" value="5" />
    <param name="pca_base_addr" value="112" /> <!-- 0x70的十进制 -->
    
    <!-- 如需启用仿真时间，取消下面注释 -->
    <!-- <param name="use_sim_time" value="false" /> -->
  </node>
</launch>