<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="shensuo_robot_control" params="use_gazebo:=false ros2_control_name plugin_type">

    <ros2_control name="${ros2_control_name}" type="system">
      <hardware>
        <plugin>${plugin_type}</plugin>
      </hardware>

      <xacro:macro name="joint_if" params="name">
        <joint name="${name}">
          <command_interface name="position"/>
          <command_interface name="velocity"/>
          <command_interface name="acceleration"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="acceleration"/>
        </joint>
      </xacro:macro>

      <xacro:joint_if name="l_post_Joint"/>
      <xacro:joint_if name="l_shoulder_Joint"/>
      <xacro:joint_if name="l_arm_JointA"/>
      <xacro:joint_if name="l_arm_JointB"/>
      <xacro:joint_if name="l_arm_JointC"/>
      <xacro:joint_if name="l_wrist_p_Joint"/>
      <xacro:joint_if name="l_wrist_y_Joint"/>
      <xacro:joint_if name="l_wrist_r_Joint"/>

      <xacro:joint_if name="r_post_Joint"/>
      <xacro:joint_if name="r_shoulder_Joint"/>
      <xacro:joint_if name="r_arm_JointA"/>
      <xacro:joint_if name="r_arm_JointB"/>
      <xacro:joint_if name="r_arm_JointC"/>
      <xacro:joint_if name="r_wrist_p_Joint"/>
      <xacro:joint_if name="r_wrist_y_Joint"/>
      <xacro:joint_if name="r_wrist_r_Joint"/>

      <xacro:joint_if name="camera_y_Joint"/>
      <xacro:joint_if name="camera_p_Joint"/>

      <xacro:joint_if name="l-hand-l-finger_Joint"/>
      <xacro:joint_if name="l-hand-r-finger_Joint"/>
      <xacro:joint_if name="r-hand-l-finger_Joint"/>
      <xacro:joint_if name="r-hand-r-finger_Joint"/>

    </ros2_control>

  </xacro:macro>
</robot>
