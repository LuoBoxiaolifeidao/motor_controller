<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="Desk">
    <link name="link">
      <pose>0 0 0 0 0 0</pose>

      <inertial>
        <mass>50</mass>
        <inertia>
          <ixx>5</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>5</iyy>
          <iyz>0</iyz>
          <izz>5</izz>
        </inertia>
      </inertial>

      <collision name="tabletop">
        <geometry>
          <box><size>1.2 0.8 0.05</size></box>
        </geometry>
        <pose>0 0 0.375 0 0 0</pose>
      </collision>

      <collision name="legs">
        <geometry>
          <box><size>0.84 0.04 0.75</size></box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <mesh><uri>meshes/desk.obj</uri></mesh>
        </geometry>
      </visual>

    </link>
  </model>
</sdf>
