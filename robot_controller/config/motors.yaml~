version: "2.0.0"

motors:
  # ===== 左臂电机配置 =====
  # 关节顺序: [0]升降立柱 DM2C  [1]肩部 MWD  [2]伸展 AK  [3][4][5]腕部 飞特
  left_dm2c:
    id: 2
    port: "/dev/ttyACM0"
    baudrate: 38400
    min_speed: 5.0
    max_speed: 150.0
    max_accel: 100
    dead_zone: 1.0

  left_mwd:
    id: 1
    interface: "can1"
    bitrate: 1000000
    min_speed: 2.0
    max_speed: 7.0
    max_accel: 10
    dead_zone: 1.0

  left_ak:
    id: 1
    interface: "can1"
    bitrate: 1000000
    min_speed: 10.0
    max_speed: 20.0
    max_accel: 500
    dead_zone: 3.0

  left_ft:
    ids: [10, 11, 12]
    port: "/dev/ttysWK0"
    baudrate: 115200
    min_speed: [40, 40, 40]
    max_speed: [400, 400, 400]
    max_accel: [400, 400, 400]
    dead_zone: [1, 1, 1]

